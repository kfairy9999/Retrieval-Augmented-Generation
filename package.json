{
  "name": "personal-knowledge-engine",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-side RAG app: Gemini embeddings, cosine retrieval, and streaming answers grounded in your documents.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit",
    "lint": "eslint .",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "deploy": "npm run build && wrangler deploy",
    "check:bundle": "node scripts/check-client-bundle.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.45.0"
  }
}
