# Used only by the local API (`npm run dev`) and by Wrangler.
# The browser bundle never reads these values. Do not commit real keys.

# Embeddings only. Gemini's embedding model returns the vectors this app searches in the browser.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Answers and query rewriting. xAI's public model list has no embedding model.
# Create one at https://console.x.ai
XAI_API_KEY=
